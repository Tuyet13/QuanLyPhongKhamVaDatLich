@model List<QuanLyPhongKhamVaDatLich.Models.MedicalHistoryViewModel>

@{
    ViewData["Title"] = "Lịch sử bệnh án";
}

<h3 class="mb-4">Lịch sử bệnh án</h3>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Chưa có hồ sơ khám bệnh.</div>
}
else
{
    <div class="accordion" id="historyAccordion">
        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            string headingId = $"heading{i}";
            string collapseId = $"collapse{i}";
            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="@headingId">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        @item.RecordDate.ToString("yyyy-MM-dd") - Bác sĩ: @item.DoctorName
                    </button>
                </h2>
                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#historyAccordion">
                    <div class="accordion-body">
                        <dl class="row">
                            <dt class="col-sm-3">Ngày khám</dt>
                            <dd class="col-sm-9">@item.RecordDate.ToString("yyyy-MM-dd HH:mm")</dd>

                            <dt class="col-sm-3">Bác sĩ điều trị</dt>
                            <dd class="col-sm-9">@item.DoctorName</dd>

                            <dt class="col-sm-3">Chẩn đoán</dt>
                            <dd class="col-sm-9">@item.Diagnosis</dd>

                            <dt class="col-sm-3">Ghi chú</dt>
                            <dd class="col-sm-9">@item.Note</dd>
                        </dl>

                        @if (item.Prescriptions != null && item.Prescriptions.Any())
                        {
                            <h6>Đơn thuốc</h6>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Thuốc</th>
                                        <th>Số lượng</th>
                                        <th>Cách dùng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in item.Prescriptions)
                                    {
                                        <tr>
                                            <td>@p.MedicineName</td>
                                            <td>@p.Quantity</td>
                                            <td>@(string.IsNullOrWhiteSpace(p.Dosage) ? "-" : p.Dosage)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="small text-muted">Không có đơn thuốc.</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}