@model QuanLyPhongKhamVaDatLich.Models.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Dashboard Bác sĩ";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>Dashboard Bác sĩ</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Segoe UI, sans-serif;
        }

        body {
            background: #f5f7fb;
        }

        .wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            background: #fff;
            border-right: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
        }

        .logo {
            text-align: center;
            padding: 25px;
            border-bottom: 1px solid #e5e7eb;
        }

            .logo img {
                width: 70px;
                height: 70px;
                object-fit: cover;
                border-radius: 15px;
                margin-bottom: 10px;
            }

            .logo h2 {
                font-size: 18px;
                color: #111827;
            }

            .logo p {
                color: #6b7280;
                font-size: 12px;
            }

        .menu {
            padding: 20px;
            flex: 1;
        }

            .menu a {
                display: block;
                text-decoration: none;
                color: #374151;
                padding: 14px;
                border-radius: 10px;
                margin-bottom: 10px;
                font-weight: 500;
            }

                .menu a:hover {
                    background: #f3f4f6;
                }

        .active {
            background: #eff6ff;
            color: #2563eb !important;
        }

        .logout {
            padding: 20px;
            border-top: 1px solid #e5e7eb;
        }

            .logout a {
                color: #f59e0b;
                text-decoration: none;
                font-weight: bold;
            }

        /* CONTENT */

        .content {
            flex: 1;
            padding: 30px;
        }

        .welcome {
            margin-bottom: 30px;
        }

            .welcome h1 {
                color: #111827;
            }

            .welcome p {
                color: #6b7280;
                margin-top: 5px;
            }

        .cards {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            color: white;
            border-radius: 15px;
            padding: 20px;
        }

            .card h2 {
                font-size: 32px;
                margin-bottom: 8px;
            }

        .blue {
            background: #2563eb;
        }

        .purple {
            background: #7c3aed;
        }

        .green {
            background: #16a34a;
        }

        .orange {
            background: #ea580c;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .panel {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

            .panel h3 {
                margin-bottom: 15px;
                color: #111827;
            }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: #f3f4f6;
            text-align: left;
        }

        th, td {
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
        }

        .badge {
            padding: 5px 10px;
            border-radius: 15px;
            font-size: 12px;
            background: #dbeafe;
            color: #1d4ed8;
        }

    </style>
    ```

</head>

<body>

        <div class="content">

            <div class="welcome">
                <h1>Xin chào, @Model.DoctorName</h1>
                <p>Chuyên khoa: @Model.Specialty</p>
            </div>

            <div class="cards">

                <div class="card blue">
                    <h2>@Model.TodayAppointments</h2>
                    <p>Lịch hẹn</p>
                </div>

                <div class="card purple">
                    <h2>@Model.TotalPatients</h2>
                    <p>Bệnh nhân</p>
                </div>

                <div class="card green">
                    <h2>@Model.SatisfactionRate%</h2>
                    <p>Đánh giá hài lòng</p>
                </div>

                <div class="card orange">
                    <h2>@Model.Productivity%</h2>
                    <p>Hiệu suất</p>
                </div>

            </div>

            <div class="grid">

                <div class="panel">

                    <h3>Lịch khám gần đây</h3>

                    <table>
                        <thead>
                            <tr>
                                <th>Bệnh nhân</th>
                                <th>Ngày khám</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.TodaySchedules)
                            {
                                <tr>
                                    <td>@item.PatientName</td>
                                    <td>@item.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>

                <div class="panel">

                    <h3>Bệnh nhân gần đây</h3>

                    <table>
                        <thead>
                            <tr>
                                <th>Tên</th>
                                <th>SĐT</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var patient in Model.RecentPatients)
                            {
                                <tr>
                                    <td>@patient.FullName</td>
                                    <td>@patient.Phone</td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>

            </div>

        </div>
        ```

    </div>

</body>
</html>
