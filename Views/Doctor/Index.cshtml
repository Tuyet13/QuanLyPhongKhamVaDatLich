@model IEnumerable<QuanLyPhongKhamVaDatLich.Models.Appointment>

<h2>Danh sách bệnh nhân đặt lịch</h2>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Ngày khám</th>
            <th>Bệnh nhân</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Patient?.FullName</td>
                <td>@item.Status</td>
                <td>
                    <a href="/Doctor/CreateRecord/@item.AppointmentId" class="btn btn-sm btn-primary">Khám bệnh</a>
                </td>
            </tr>
        }
    </tbody>
</table>