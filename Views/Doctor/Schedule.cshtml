@model IEnumerable<QuanLyPhongKhamVaDatLich.Models.Appointment>

    @{
    ViewData["Title"] = "L?ch khám";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    }

    <link rel="stylesheet" href="~/css/doctor.css" />

    <div class="doctor-container">

        <h2 class="page-title">Lịch khám hôm nay</h2>

        <table class="table table-bordered doctor-table">

            <thead>
                <tr>
                <th>Bệnh nhân</th>
                <th>SĐT</th>
                <th>Ngày khám</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Patient?.FullName</td>
                    <td>@item.Patient?.Phone</td>
                    <td>@item.AppointmentDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Status</td>
                    <td>

                        <a asp-controller="Doctor"
                           asp-action="Examine"
                           asp-route-id="@item.AppointmentId"
                           class="btn btn-primary">
                            Khám bệnh
                        </a>

                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>
