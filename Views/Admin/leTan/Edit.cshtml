@model QuanLyPhongKhamVaDatLich.Models.Receptionist
@{
    ViewData["Title"] = "Chỉnh sửa thông tin lễ tân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container px-4 py-3" style="max-width: 800px;">
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
        <h5 class="fw-bold mb-4 text-dark"><i class="fa fa-user-edit text-warning me-2"></i>Chỉnh sửa hồ sơ lễ tân</h5>

        <form asp-controller="Admin" asp-action="EditReceptionist" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReceptionistId" />
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Họ và tên</label>
                    <input asp-for="FullName" class="form-control" required style="border-radius: 8px;" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control" required style="border-radius: 8px;" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Lương cơ bản</label>
                    <input asp-for="BaseSalary" type="number" class="form-control" required style="border-radius: 8px;" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-muted">Ngày vào làm</label>
                    <input asp-for="HireDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" required style="border-radius: 8px;" />
                </div>

                <div class="col-12 d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Receptionists" class="btn btn-light px-4 border" style="border-radius: 8px;">Quay lại</a>
                    <button type="submit" class="btn btn-warning px-4 text-white" style="border-radius: 8px;">Lưu cập nhật</button>
                </div>
            </div>
        </form>
    </div>
</div>