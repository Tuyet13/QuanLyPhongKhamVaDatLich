@model QuanLyPhongKhamVaDatLich.Models.Patient
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ bệnh nhân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: #ffffff; max-width: 800px; margin: 0 auto;">

        <div class="d-flex align-items-center mb-4 border-bottom pb-3">
            <a asp-controller="Admin" asp-action="Patients" class="btn btn-sm btn-light border me-3 rounded-circle" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                <i class="fa fa-arrow-left text-secondary"></i>
            </a>
            <h5 class="fw-bold mb-0 text-dark"><i class="fa fa-edit text-warning me-2"></i>Chỉnh sửa hồ sơ bệnh nhân</h5>
        </div>

        <form asp-controller="Admin" asp-action="EditPatient" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="UserId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Họ và tên bệnh nhân</label>
                    <input type="text" asp-for="FullName" class="form-control rounded-3" required placeholder="Nhập họ tên..." />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Giới tính</label>
                    <select asp-for="Gender" class="form-select rounded-3">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Ngày tháng năm sinh</label>
                    <input type="date" asp-for="BirthDate" class="form-control rounded-3" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Số điện thoại liên hệ</label>
                    <input type="tel" asp-for="Phone" class="form-control rounded-3" placeholder="Nhập SĐT..." />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Địa chỉ Email</label>
                    <input type="email" asp-for="Email" class="form-control rounded-3" placeholder="name@example.com" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Trạng thái hoạt động</label>
                    <select asp-for="IsActive" class="form-select rounded-3">
                        <option value="true">Cho phép hoạt động (Kích hoạt)</option>
                        <option value="false">Khóa tài khoản (Banned)</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold text-secondary small">Địa chỉ thường trú</label>
                    <textarea asp-for="Address" class="form-control rounded-3" rows="3" placeholder="Số nhà, tên đường, xã/phường..."></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-controller="Admin" asp-action="Patients" class="btn btn-light border px-4 rounded-pill">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm" style="background: var(--primary-admin, #4a00e0); border: none;">
                    <i class="fa fa-save me-2"></i>Lưu cập nhật
                </button>
            </div>
        </form>
    </div>
</div>