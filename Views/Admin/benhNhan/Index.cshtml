@model IEnumerable<QuanLyPhongKhamVaDatLich.Models.Patient>
@{
    ViewData["Title"] = "Danh sách bệnh nhân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .table-hover tbody tr {
        transition: background-color 0.2s ease-in-out;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(74, 0, 224, 0.03) !important;
        }

    .btn-action-custom {
        border-radius: 8px;
        transition: all 0.2s;
    }

        .btn-action-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
        }
</style>

<div class="container-fluid px-4 py-3">
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: #ffffff;">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 10px; background-color: rgba(40, 167, 69, 0.1); color: #28a745;">
                <i class="fa fa-check-circle me-2 text-success"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 10px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                <i class="fa fa-exclamation-circle me-2 text-danger"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fa fa-user-injured text-primary me-2"></i>Quản lý danh sách bệnh nhân
            </h5>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">
                Tổng số hồ sơ: @(Model?.Count() ?? 0)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle border-0 mb-0">
                <thead class="table-light border-bottom text-muted small text-uppercase" style="background-color: #f8f9fa;">
                    <tr>
                        <th width="8%" class="ps-3">STT</th>
                        <th width="27%">Họ và tên</th>
                        <th width="12%">Giới tính</th>
                        <th width="15%">Ngày sinh</th>
                        <th width="15%">Điện thoại</th>
                        <th width="13%">Trạng thái</th>
                        <th width="10%" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-secondary fw-bold ps-3">#@stt</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: rgba(0, 180, 216, 0.1); color: #00b4d8;">
                                            <i class="fa fa-user fs-5"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@item.FullName</span>
                                            <small class="text-muted" style="font-size: 11px;">@(item.User != null ? item.User.Email : item.Email)</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-secondary">
                                    @(string.IsNullOrEmpty(item.Gender) ? "---" : item.Gender)
                                </td>
                                <td class="text-secondary">
                                    @(item.BirthDate != null ? item.BirthDate.Value.ToString("dd/MM/yyyy") : "---")
                                </td>
                                <td class="text-secondary fw-medium">
                                    @(string.IsNullOrEmpty(item.Phone) ? "---" : item.Phone)
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-soft-success text-success px-2 py-1.5" style="background-color: rgba(40,167,69,0.1); font-size: 11px;">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-soft-danger text-danger px-2 py-1.5" style="background-color: rgba(220,53,69,0.1); font-size: 11px;">Đã khóa</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-controller="Admin" asp-action="DetailsPatient" asp-route-id="@item.PatientId" class="btn btn-sm btn-light border btn-action-custom" title="Chi tiết hồ sơ">
                                            <i class="fa fa-eye text-info"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="EditPatient" asp-route-id="@item.PatientId" class="btn btn-sm btn-light border btn-action-custom" title="Chỉnh sửa thông tin">
                                            <i class="fa fa-edit text-warning"></i>
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeletePatient" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bệnh nhân này không? Hãy cân nhắc kỹ vì hành động này có thể ảnh hưởng đến lịch sử lịch hẹn.');">
                                            <input type="hidden" name="id" value="@item.PatientId" />
                                            <button type="submit" class="btn btn-sm btn-light border btn-action-custom" title="Xóa bỏ">
                                                <i class="fa fa-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div class="mb-2"><i class="fa fa-users-slash fs-2 text-secondary opacity-50"></i></div>
                                <span>Hệ thống chưa ghi nhận dữ liệu bệnh nhân nào.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>