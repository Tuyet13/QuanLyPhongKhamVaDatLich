@model QuanLyPhongKhamVaDatLich.Models.Patient
@{
    ViewData["Title"] = "Chi tiết hồ sơ bệnh nhân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: #ffffff; max-width: 750px; margin: 0 auto;">

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
            <div class="d-flex align-items-center">
                <a asp-controller="Admin" asp-action="Patients" class="btn btn-sm btn-light border me-3 rounded-circle" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="fa fa-arrow-left text-secondary"></i>
                </a>
                <h5 class="fw-bold mb-0 text-dark"><i class="fa fa-id-card text-info me-2"></i>Hồ sơ chi tiết bệnh nhân</h5>
            </div>
            <a asp-controller="Admin" asp-action="EditPatient" asp-route-id="@Model.PatientId" class="btn btn-sm btn-warning px-3 rounded-pill text-white fw-medium">
                <i class="fa fa-edit me-1"></i> Chỉnh sửa
            </a>
        </div>

        <div class="row align-items-center mb-4 bg-light p-3 mx-1 rounded-3">
            <div class="col-sm-3 text-center mb-3 mb-sm-0">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; background-color: rgba(0, 180, 216, 0.1); color: #00b4d8;">
                    <i class="fa fa-user fs-1"></i>
                </div>
            </div>
            <div class="col-sm-9 text-center text-sm-start">
                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted mb-2 small">Mã số bệnh nhân toàn hệ thống: <span class="fw-bold text-primary">#@Model.PatientId</span></p>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1.5 rounded-pill">Tài khoản khả dụng</span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1.5 rounded-pill">Đang bị khóa</span>
                }
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <tbody>
                    <tr>
                        <th width="30%" class="bg-light text-secondary fw-semibold small ps-3">Ngày sinh</th>
                        <td class="ps-3">@(Model.BirthDate != null ? Model.BirthDate.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-secondary fw-semibold small ps-3">Giới tính</th>
                        <td class="ps-3">@(string.IsNullOrEmpty(Model.Gender) ? "Chưa xác định" : Model.Gender)</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-secondary fw-semibold small ps-3">Số điện thoại</th>
                        <td class="ps-3 text-dark fw-medium">@(string.IsNullOrEmpty(Model.Phone) ? "Không có" : Model.Phone)</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-secondary fw-semibold small ps-3">Hòm thư Email</th>
                        <td class="ps-3">@(string.IsNullOrEmpty(Model.Email) ? "Không có" : Model.Email)</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-secondary fw-semibold small ps-3">Địa chỉ cư trú</th>
                        <td class="ps-3">@(string.IsNullOrEmpty(Model.Address) ? "Chưa ghi nhận thông tin nơi ở" : Model.Address)</td>
                    </tr>
                    <tr>
                        <th class="bg-light text-secondary fw-semibold small ps-3">Tên đăng nhập hệ thống</th>
                        <td class="ps-3 text-secondary italic">@(Model.User != null ? Model.User.Username : "Không có tài khoản liên kết")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>