@model IEnumerable<QuanLyPhongKhamVaDatLich.Models.Appointment>
@{
    ViewData["Title"] = "Bảng điều khiển Dashboard";
    Layout = "_AdminLayout";
}

<style>
    .stat-card {
        border-radius: 16px;
        border: none;
        transition: 0.3s;
        background: #fff;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .activity-item {
        border-left: 2px solid #e9ecef;
        padding-left: 20px;
        position: relative;
        padding-bottom: 20px;
    }

        .activity-item::before {
            content: "";
            position: absolute;
            left: -6px;
            top: 0;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #0d6efd; /* Sửa biến CSS tĩnh để tránh lỗi không nhận màu */
        }
</style>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card p-3 shadow-sm">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                    <i class="fa fa-users"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0">Tổng bệnh nhân</p>
                    <h4 class="fw-bold mb-0">@ViewBag.TotalPatients</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3 shadow-sm">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                    <i class="fa fa-user-md"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0">Bác sĩ hoạt động</p>
                    <h4 class="fw-bold mb-0">@ViewBag.TotalDoctors</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3 shadow-sm">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-info bg-opacity-10 text-info me-3">
                    <i class="fa fa-calendar-check"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0">Lịch hẹn hôm nay</p>
                    <h4 class="fw-bold mb-0">@ViewBag.TotalAppointments</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card p-3 shadow-sm">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger me-3">
                    <i class="fa fa-wallet"></i>
                </div>
                <div>
                    <p class="text-muted small mb-0">Doanh thu tháng</p>
                    <h4 class="fw-bold mb-0 text-danger">@ViewBag.TotalRevenue</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bold mb-0">Phân tích tăng trưởng</h6>
                <span class="badge bg-light text-dark text-xs">Dữ liệu thời gian thực</span>
            </div>
            <div class="d-flex align-items-end justify-content-between" style="height: 200px; padding: 0 20px;">
                <div class="bg-primary bg-opacity-25" style="width: 12%; height: 40%; border-radius: 8px;" title="Tháng 1"></div>
                <div class="bg-primary bg-opacity-50" style="width: 12%; height: 65%; border-radius: 8px;" title="Tháng 2"></div>
                <div class="bg-primary bg-opacity-75" style="width: 12%; height: 50%; border-radius: 8px;" title="Tháng 3"></div>
                <div class="bg-primary" style="width: 12%; height: 90%; border-radius: 8px;" title="Tháng 4"></div>
            </div>
            <div class="d-flex justify-content-between mt-3 px-2 text-muted small">
                <span>Tháng 1</span><span>Tháng 2</span><span>Tháng 3</span><span>Tháng 4</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="UserList" class="card border-0 shadow-sm p-4 text-center text-decoration-none bg-white h-100" style="border-radius: 16px;">
                    <i class="fa fa-id-card fa-2x text-info mb-3"></i>
                    <h6 class="fw-bold text-dark mb-1">Hồ sơ Bệnh nhân</h6>
                    <p class="text-muted small mb-0">Xem và quản lý thông tin</p>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-controller="Admin" asp-action="Doctors" class="card border-0 shadow-sm p-4 text-center text-decoration-none bg-white h-100" style="border-radius: 16px;">
                    <i class="fa fa-stethoscope fa-2x text-primary mb-3"></i>
                    <h6 class="fw-bold text-dark mb-1">Quản lý Bác sĩ</h6>
                    <p class="text-muted small mb-0">Cấp tài khoản & Điều phối nhân sự</p>
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 16px;">
            <h6 class="fw-bold mb-4">Lịch hẹn vừa đăng ký</h6>
            <div class="activity-feed">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="activity-item">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold small text-primary">Mã #@item.AppointmentId</span>
                                <span class="text-muted" style="font-size: 11px;">@item.AppointmentDate.ToString("HH:mm")</span>
                            </div>
                            <p class="mb-0 small fw-medium mt-1">Bác sĩ: @(item.Doctor != null ? item.Doctor.FullName : "Đang chờ...")</p>
                            <p class="text-muted small mb-0">Ngày khám: @item.AppointmentDate.ToString("dd/MM/yyyy")</p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa fa-calendar-times fa-3x text-light mb-3"></i>
                        <p class="text-muted small">Không có hoạt động nào hôm nay</p>
                    </div>
                }
            </div>
            <div class="mt-auto border-top pt-3 text-center">
                <a asp-controller="Appointment" asp-action="Index" class="text-decoration-none small fw-bold">Xem tất cả lịch hẹn <i class="fa fa-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>