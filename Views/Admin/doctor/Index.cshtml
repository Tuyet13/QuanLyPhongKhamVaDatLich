@model IEnumerable<QuanLyPhongKhamVaDatLich.Models.Doctor>
@{
    ViewData["Title"] = "Danh sách bác sĩ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* Hiệu ứng hover nhẹ và mượt khi rê chuột qua các hàng trong bảng */
    .table-hover tbody tr {
        transition: background-color 0.2s ease-in-out;
    }

        .table-hover tbody tr:hover {
            background-color: rgba(74, 0, 224, 0.03) !important;
        }
    /* Bo góc nhẹ cho các nút hành động */
    .btn-action-custom {
        border-radius: 8px;
        transition: all 0.2s;
    }

        .btn-action-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.05);
        }
</style>

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-end mb-3 gap-2">
        <a asp-controller="Admin" asp-action="StaffPerformance" class="btn btn-outline-primary px-3 rounded-pill btn-action-custom">
            <i class="fa fa-chart-line me-2"></i>Xem bảng lương & hiệu suất tổng hợp
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4" style="border-radius: 16px; background: #ffffff;">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 10px; background-color: rgba(40, 167, 69, 0.1); color: #28a745;">
                <i class="fa fa-check-circle me-2 text-success"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" style="border-radius: 10px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                <i class="fa fa-exclamation-circle me-2 text-danger"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="fa fa-user-md text-primary me-2"></i>Quản lý danh sách bác sĩ
            </h5>
            <a asp-controller="Admin" asp-action="CreateDoctor" class="btn btn-primary px-4 rounded-pill shadow-sm" style="background: var(--primary-admin, #4a00e0); border: none;">
                <i class="fa fa-plus me-2"></i>Thêm bác sĩ mới
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle border-0 mb-0">
                <thead class="table-light border-bottom text-muted small text-uppercase" style="background-color: #f8f9fa;">
                    <tr>
                        <th width="5%" class="ps-3">STT</th>
                        <th width="25%">Họ và tên bác sĩ</th>
                        <th width="20%">Chuyên khoa</th>
                        <th width="15%">Điện thoại</th>
                        <th width="12%">Đánh giá</th>
                        <th width="10%">Ngày vào làm</th>
                        <th width="13%" class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-secondary fw-bold ps-3">#@stt</td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: rgba(74, 0, 224, 0.1); color: #4a00e0;">
                                            <i class="fa fa-user-md fs-5"></i>
                                        </div>
                                        <div>
                                            <span class="fw-semibold text-dark d-block">@item.FullName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-medium" style="background-color: rgba(74, 0, 224, 0.06) !important; color: #4a00e0 !important;">
                                        @(item.Specialty != null ? item.Specialty.SpecialtyName : "Chưa chỉ định")
                                    </span>
                                </td>
                                <td class="text-secondary fw-medium">
                                    @(string.IsNullOrEmpty(item.Phone) ? "---" : item.Phone)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-warning small">
                                        <i class="fa fa-star me-1"></i>
                                        <span class="text-dark fw-bold">@item.Rating.ToString("0.0")</span>
                                    </div>
                                </td>
                                <td class="text-secondary small">
                                    @item.HireDate.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-controller="Admin" asp-action="DetailsDoctor" asp-route-id="@item.DoctorId" class="btn btn-sm btn-light border btn-action-custom" title="Chi tiết hồ sơ">
                                            <i class="fa fa-eye text-info"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="EditDoctor" asp-route-id="@item.DoctorId" class="btn btn-sm btn-light border btn-action-custom" title="Chỉnh sửa thông tin">
                                            <i class="fa fa-edit text-warning"></i>
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeleteDoctor" asp-route-id="@item.DoctorId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bác sĩ này và tài khoản liên quan không? Hãy cân nhắc vì hành động này có thể ảnh hưởng đến lịch hẹn hiện tại.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border btn-action-custom" title="Xóa nhân sự">
                                                <i class="fa fa-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <div class="mb-2"><i class="fa fa-user-md-slash fs-2 text-secondary opacity-50"></i></div>
                                <span>Chưa có dữ liệu bác sĩ nào trong hệ thống.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>