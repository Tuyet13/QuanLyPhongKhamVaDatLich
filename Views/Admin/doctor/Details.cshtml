@model QuanLyPhongKhamVaDatLich.Models.Doctor
@{
    ViewData["Title"] = "Chi tiết nhân sự";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4" style="border-radius: 16px;">
                <div class="text-center pb-4 border-bottom">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="fa fa-user-md fa-2x"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@Model.FullName</h5>
                    <span class="badge bg-primary px-3 py-2 rounded-pill small">
                        @(Model.Specialty != null ? Model.Specialty.SpecialtyName : "Chưa phân loại")
                    </span>
                </div>

                <div class="py-4">
                    <h6 class="fw-bold mb-3 text-secondary small text-uppercase">Hồ sơ lý lịch nội bộ</h6>
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <td width="40%" class="text-muted small"><i class="fa fa-id-card me-2"></i>Mã số bác sĩ:</td>
                                <td class="fw-bold text-dark">#@Model.DoctorId</td>
                            </tr>
                            <tr>
                                <td class="text-muted small"><i class="fa fa-envelope me-2"></i>Email đăng nhập:</td>
                                <td class="text-dark">@ViewBag.Email</td>
                            </tr>
                            <tr>
                                <td class="text-muted small"><i class="fa fa-phone me-2"></i>Điện thoại di động:</td>
                                <td class="text-dark">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa đăng ký số điện thoại" : Model.Phone)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-controller="Admin" asp-action="Doctors" class="btn btn-light border px-4 rounded-pill">Quay lại danh sách</a>
                    <a asp-controller="Admin" asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn btn-warning px-4 rounded-pill text-white">Chỉnh sửa</a>
                </div>
            </div>
        </div>
    </div>
</div>