@model QuanLyPhongKhamVaDatLich.Models.LoginViewModel
@{
    Layout = "_Layout";
}

<style>
    /* Hiệu ứng rung khi có lỗi */
    .shake {
        animation: shake 0.5s;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-5px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(5px);
        }
    }

    /* Chỉnh màu icon và trạng thái focus của nút con mắt */
    .btn-show-pass {
        border-color: #dee2e6 !important;
        color: #008ca3 !important;
    }

        .btn-show-pass:hover {
            background-color: #f8f9fa !important;
        }

    .register-link {
        color: #008ca3;
        text-decoration: none;
        font-weight: 600;
    }

        .register-link:hover {
            text-decoration: underline;
        }

    /* Tùy chỉnh riêng cho cụm chọn Vai trò */
    .role-group {
        border: 1px solid #ced4da;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease-in-out;
        background-color: #ffffff;
    }

        .role-group:focus-within {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.15);
        }

        .role-group .input-group-text {
            background-color: #fff9e6 !important;
            border: none !important;
            padding-right: 12px;
            padding-left: 15px;
            border-right: 1px solid #f1f1f1 !important;
        }

        .role-group .form-select {
            border: none !important;
            box-shadow: none !important;
            font-weight: 500;
            color: #495057;
            cursor: pointer;
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 @(ViewBag.Error != null ? "shake" : "")">
                <div class="card-body p-4 text-center">
                    <h4 class="fw-bold mb-4" style="color: #008ca3;">ĐĂNG NHẬP</h4>

                    @* KHU VỰC HIỂN THỊ THÔNG BÁO LỖI *@
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show small text-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.5rem;"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        @* Chọn Vai trò *@
                        <div class="mb-3 text-start">
                            <label class="small fw-bold text-muted mb-1">Bạn là ai?</label>
                            <div class="input-group role-group">
                                <span class="input-group-text">
                                    <i class="bi bi-house-door-fill" style="color: #ffc107; font-size: 1.2rem;"></i>
                                </span>
                                <select name="Role" class="form-select py-2" required>
                                    <option value="" disabled selected>-- Chọn vai trò --</option>
                                    <option value="Patient">🏥 Bệnh nhân</option>
                                    <option value="Doctor">👨‍⚕️ Bác sĩ</option>
                                    <option value="Receptionist">💁 Lễ tân</option>
                                    <option value="Admin">⚙️ Quản trị hệ thống</option>
                                </select>
                            </div>
                        </div>

                        @* Email/Username *@
                        <div class="mb-3 text-start">
                            <label class="small fw-bold text-muted mb-1">Tài khoản</label>
                            <input type="text" name="Email" class="form-control py-2"
                                   placeholder="Email hoặc Tên đăng nhập"
                                   value="@(Model?.Email)" required />
                        </div>

                        @* Mật khẩu *@
                        <div class="mb-4 text-start">
                            <label class="small fw-bold text-muted mb-1">Mật khẩu</label>
                            <div class="input-group">
                                <input type="password" name="Password" id="passLogin" class="form-control py-2" placeholder="Nhập mật khẩu" required />
                                <button class="btn btn-outline-secondary btn-show-pass" type="button" onclick="togglePass('passLogin', 'iconLogin')">
                                    <i class="bi bi-eye-slash" id="iconLogin"></i>
                                </button>
                            </div>
                        </div>

                        @* Nút đăng nhập *@
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold mb-3" style="background: #008ca3; border:none;">
                            VÀO HỆ THỐNG
                        </button>

                        @* Link đăng ký *@
                        <div class="mt-3">
                            <p class="small mb-0 text-muted">
                                Bạn chưa có tài khoản?
                                <a asp-action="Register" class="register-link">Đăng ký ngay</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.className = "bi bi-eye";
            } else {
                input.type = "password";
                icon.className = "bi bi-eye-slash";
            }
        }

        // Tự động ẩn thông báo lỗi sau 5 giây
        setTimeout(function () {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}